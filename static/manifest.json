{
  "manifest_version": 3,
  "name": "Christian's Download Any Video",
  "version": "1.2.3",
  "description": "Download the video on the page you are looking at: one click, and it lands in your downloads folder as an MP4 that plays everywhere.",
  "minimum_chrome_version": "126",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "offscreen",
    "storage"
  ],
  "host_permissions": ["<all_urls>"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "cross_origin_embedder_policy": { "value": "require-corp" },
  "cross_origin_opener_policy": { "value": "same-origin" },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Download the video on this page",
    "default_icon": {
      "16": "icons/on-dark/icon-16.png",
      "32": "icons/on-dark/icon-32.png",
      "48": "icons/on-dark/icon-48.png",
      "128": "icons/on-dark/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/on-dark/icon-16.png",
    "32": "icons/on-dark/icon-32.png",
    "48": "icons/on-dark/icon-48.png",
    "128": "icons/on-dark/icon-128.png"
  }
}
